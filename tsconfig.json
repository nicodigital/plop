{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*.ts",
    "src/**/*.astro",
    "*.mjs",
    "scripts/check-google-posts.ts"
  ],
  "exclude": ["dist", "worker"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  }
}
