---
import GooeyStack from "./GooeyStack.astro";
import Logo from "../ui/Logo.astro";
import ContactForm from "../ui/ContactForm.astro";
import Icon from "../ui/Icon.astro";
import { ADDRESS, CNPJ, CONTACT_EMAIL, HAS_WHATSAPP, LOCAL_SUMMARY, PHONE_DISPLAY, PHONE_NUMBER, SITE_NAME, whatsappHref } from "../../data/site.ts";

const year = new Date().getFullYear();
---

{/*
  The footer is the site's contact section: it carries the `#contato` target
  every CTA and the nav point at, so the id belongs on the block that holds
  the invitation and the form, not on the form element itself.
*/}
<footer id="contato" class="on-ink" aria-labelledby="contato-titulo">
  <GooeyStack variant="b">
    <div class="shell py-[clamp(56px,10vw,150px)]">
      <div class="spine-grid">
        <div>
          <h2 id="contato-titulo" class="text-h1 xg:text-h2">
            Bora começar<br />
            o <span class="text-plop-lime">seu site</span>.
          </h2>
          <p class="muted measure mt-6 leading-[1.3] lg:max-w-[35ch]">
            Conte o que o seu negócio faz e qual plano te interessa. A resposta vem
            com prazo, escopo e preço fechado — sem reunião obrigatória.
          </p>

          {/* The long lead-in is a desktop rhythm; on a phone it is a blank
              screenful between the invitation and the way to answer it. */}
          <dl
            class="mt-8 flex flex-col gap-6 pt-2 lg:mt-10 lg:gap-10 lg:pt-20"
            aria-label="Canais de contato diretos"
          >
            <div>
              <dt class="muted flex items-center gap-2 font-semibold">
                <Icon name={HAS_WHATSAPP ? "phone" : "send"} size={22} class="shrink-0" />
                {HAS_WHATSAPP ? "Telefone" : "Formulário"}
              </dt>
              <dd class="mt-1">
                <a
                  href={HAS_WHATSAPP ? `tel:${PHONE_NUMBER}` : whatsappHref()}
                  class="inline-flex min-h-[44px] items-center font-display text-ui-xl font-semibold text-white transition-colors duration-[var(--duration-fast)] hover:text-plop-lime"
                  data-track="phone_click"
                >
                  {HAS_WHATSAPP ? PHONE_DISPLAY : "Preencher o formulário"}
                </a>
              </dd>
            </div>
            <div>
              <dt class="muted flex items-center gap-2 font-semibold">
                <Icon name="email" size={22} class="shrink-0" />
                E-mail
              </dt>
              <dd class="mt-1">
                <a
                  href={`mailto:${CONTACT_EMAIL}`}
                  class="inline-flex min-h-[44px] items-center font-display text-ui-xl font-semibold text-white transition-colors duration-[var(--duration-fast)] hover:text-plop-lime"
                >
                  {CONTACT_EMAIL}
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="rounded-[var(--radius-plop-xl)] xg:bg-white/20 xg:border xg:border-blue-300 xg:p-12 [corner-shape:squircle] backdrop-blur-xs max-w-full mt-20 mb-10 xg:my-0 anim" data-anim="bottom" data-delay="200">
          <h3 id="contato-form-titulo" class="text-h2 xg:text-h3 text-white">
            Entre em contato
          </h3>
          <p class="text-small xg:text-base mt-3 text-white leading-[1.2]">
            Todos os campos, menos o último, são necessários <br> para responder direito.
          </p>
          <div class="relative mt-7">
            <ContactForm id="footer-contato" labelledBy="contato-form-titulo" />
          </div>
        </div>
      </div>
    </div>

    <div class="lg:-mt-60">
      <div
        class="shell flex flex-col gap-8 py-9 lg:flex-row lg:items-center lg:justify-between"
      >
        <div class="flex flex-col items-start gap-5">
          <Logo width={200}  decorative class="w-[12rem]" />
          <p class="muted max-w-[36ch] text-small xg:text-ui">
            Sites profissionais para negócios independentes. Construídos,
            publicados e cuidados todo mês.
          </p>
        </div>

        <div class="pt-10 lg:w-[50%] lg:pt-20">
          <h4 class="balanced-breaks text-h2 xg:text-h3 text-white">
            Fale com a gente<br /> e coloque <span class="text-plop-lime"> seu negócio no ar.</span>
          </h4>
        </div>

      </div>

      {/* The fixed WhatsApp affordance lives in this corner, so the last line
          of the page keeps clear of it rather than sitting under it. */}
      <div class="shell pb-9 flex justify-between">
        {/* The policy used to be reachable from nowhere: it was in the
            sitemap and in `llms.txt`, but no page on the site linked to it,
            which is both an orphan URL and a document the LGPD expects a
            visitor to be able to find. */}
        <div class="xg:w-[50%] flex flex-col gap-2">
          <p class="muted text-small">
            © {year} {SITE_NAME} — Todos os direitos reservados.
          </p>
          {/* The one identifier a cautious Brazilian buyer looks for, and the
              one a business client needs before it can be invoiced. Marked up
              so the number is selectable and copyable as a unit. */}
          <p class="muted text-small">
            CNPJ <span data-numeric>{CNPJ}</span>
          </p>
          {/* 44px of vertical hit area, not 18. These are standalone nav links in a
              flex row, so the inline-text exception to WCAG 2.2 SC 2.5.8 does not
              cover them — the text size is unchanged, only the box around it. */}
          <nav class="-my-2 flex flex-wrap gap-x-5" aria-label="Institucional">
            <a
              class="muted inline-flex min-h-[44px] items-center text-small transition-colors duration-[var(--duration-fast)] hover:text-white hover:underline"
              href="/sobre/">Sobre</a
            >
            <a
              class="muted inline-flex min-h-[44px] items-center text-small transition-colors duration-[var(--duration-fast)] hover:text-white hover:underline"
              href="/privacidade/">Política de privacidade</a
            >
          </nav>
        </div>
        {/* The visible half of the `PostalAddress` in `organizationSchema()`,
            read from the same constants, so the markup a crawler sees and the
            JSON-LD it trusts can never drift apart. `LOCAL_SUMMARY` sits above
            it as ordinary prose: the city has to exist in text, not only in
            structured data, for anything that retrieves over text to find it. */}
        <div class="xg:w-[50%] flex flex-col gap-1">
          <p class="muted text-small">{LOCAL_SUMMARY}</p>
          <address class="muted text-small not-italic" aria-label="Endereço">
            <span>{ADDRESS.city}, {ADDRESS.regionName}, {ADDRESS.country}.</span>
          </address>
        </div>
      </div>
    </div>
  </GooeyStack>
</footer>
