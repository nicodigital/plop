---
/**
 * Inner-page opening. The header sits absolute over it, so every route
 * begins on the brand blue and the wordmark keeps its approved variant.
 */
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="on-blue relative isolate overflow-hidden bg-plop-blue-deep">
  <div
    class="pointer-events-none absolute -right-[12%] -top-[70%] -z-10 size-[min(70vw,760px)] rounded-full bg-[radial-gradient(circle_at_40%_58%,color-mix(in_srgb,var(--color-plop-blue)_85%,transparent),transparent_68%)]"
    aria-hidden="true"
  >
  </div>

  <div
    class="shell pb-[clamp(48px,7vw,88px)] pt-[clamp(132px,16vh,184px)]"
  >
    <h1 class="max-w-[18ch] text-[length:var(--text-h1)]">{title}</h1>
    {
      intro && (
        <p class="muted measure mt-7 text-[length:var(--text-lead)]">{intro}</p>
      )
    }
  </div>
</section>
