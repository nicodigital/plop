---
/**
 * Inner-page opening. The header sits absolute over it, so every route
 * begins on the brand blue and the wordmark keeps its approved variant.
 *
 * The blue itself is not ours: every caller slots this into a GooeyStack, so
 * the liquid ground is shared with whatever section follows instead of being
 * a flat panel that stops at our own bottom edge.
 */
interface Props {
  title: string;
  intro?: string;
}

const { title, intro } = Astro.props;
---

<section class="on-blue">
  <div
    class="shell pb-[clamp(48px,7vw,88px)] pt-[clamp(160px,20vh,300px)]"
  >
    <h1 class="max-w-[18ch] text-[length:var(--text-h1)]">{title}</h1>
    {
      intro && (
        <p class="muted measure mt-7 text-[length:var(--text-lead)] max-w-[40ch]">
          {intro}
        </p>
      )
    }
  </div>
</section>
