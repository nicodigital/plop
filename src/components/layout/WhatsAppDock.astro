---
import Icon from "../ui/Icon.astro";
import { HAS_WHATSAPP, whatsappHref } from "../../data/site.ts";
---

{/*
  Fixed conversion affordance. Sits above the safe-area inset so it never
  lands under a phone's home indicator, and shrinks to the icon on small
  screens so it cannot cover a CTA.
*/}
<a
  href={whatsappHref()}
  class="group fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-4 z-40 inline-flex min-h-[56px] items-center gap-3 rounded-full bg-plop-ink pl-4 pr-4 font-display font-semibold text-white no-underline transition-[background-color,transform] duration-[var(--duration-fast)] ease-[var(--ease-plop-out)] hover:bg-plop-blue-800 sm:pr-6 lg:bottom-8 lg:right-8"
  data-track={HAS_WHATSAPP ? "whatsapp_click" : "cta_primary_click"}
  rel="noopener"
>
  <span
    class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-plop-lime text-plop-ink -ml-2"
  >
    <Icon name="whatsapp" size={30} />
  </span>
  <span class="hidden sm:inline">{HAS_WHATSAPP ? "WhatsApp" : "Fale com a gente"}</span>
  <span class="sr-only sm:hidden">
    {HAS_WHATSAPP ? "Falar no WhatsApp" : "Ir para o formulário de contato"}
  </span>
</a>
