---
import Button from "./Button.astro";

interface Props {
  /** Distinguishes the footer instance from the /contato/ page instance. */
  id?: string;
  /**
   * Id of the heading that already introduces the form on the surface
   * mounting it. A <form> is only a landmark once it has a name, and the
   * heading is the name — repeating it in an aria-label would announce the
   * same words twice.
   */
  labelledBy?: string;
}

const { id = "contato", labelledBy } = Astro.props;
/* Public by design: it is served in the HTML to every visitor. The matching
   secret never leaves the Worker. */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const field =
  "w-full rounded-[var(--radius-plop-md)] [corner-shape:squircle] bg-white text-black px-4 py-3 border-2 border-transparent transition-colors duration-[var(--duration-fast)] placeholder:text-plop-on-white/60 focus:border-plop-blue-700 focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-plop-lime";
const label = "block font-semibold text-ui text-white";
---

<form
  id={id}
  class="flex flex-col gap-5"
  method="post"
  action="/api/contato"
  novalidate
  aria-labelledby={labelledBy}
  aria-label={labelledBy ? undefined : "Formulário de contato"}
  data-contact-form
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="flex flex-col gap-2">
      <label class={label} for={`${id}-nome`}>Seu nome</label>
      <input
        class={field}
        id={`${id}-nome`}
        name="nome"
        type="text"
        autocomplete="name"
        required
        aria-describedby={`${id}-nome-erro`}
      />
      <p
        class="hidden text-small font-semibold text-plop-pink"
        id={`${id}-nome-erro`}
        aria-live="polite"
        data-error-for="nome"
      >
      </p>
    </div>

    <div class="flex flex-col gap-2">
      <label class={label} for={`${id}-negocio`}>Seu negócio</label>
      <input
        class={field}
        id={`${id}-negocio`}
        name="negocio"
        type="text"
        required
        placeholder="Padaria, clínica, imobiliária…"
        aria-describedby={`${id}-negocio-erro`}
      />
      <p
        class="hidden text-small font-semibold text-plop-pink"
        id={`${id}-negocio-erro`}
        aria-live="polite"
        data-error-for="negocio"
      >
      </p>
    </div>

    <div class="flex flex-col gap-2">
      <label class={label} for={`${id}-email`}>E-mail</label>
      <input
        class={field}
        id={`${id}-email`}
        name="email"
        type="email"
        autocomplete="email"
        required
        aria-describedby={`${id}-email-erro`}
      />
      <p
        class="hidden text-small font-semibold text-plop-pink"
        id={`${id}-email-erro`}
        aria-live="polite"
        data-error-for="email"
      >
      </p>
    </div>

    <div class="flex flex-col gap-2">
      <label class={label} for={`${id}-whatsapp`}>WhatsApp</label>
      <input
        class={field}
        id={`${id}-whatsapp`}
        name="whatsapp"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        required
        placeholder="(41) 99999-9999"
        aria-describedby={`${id}-whatsapp-erro`}
      />
      <p
        class="hidden text-small font-semibold text-plop-pink"
        id={`${id}-whatsapp-erro`}
        aria-live="polite"
        data-error-for="whatsapp"
      >
      </p>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <label class={label} for={`${id}-mensagem`}>
      O que você precisa <span class="font-normal">(opcional)</span>
    </label>
    <textarea class={field} id={`${id}-mensagem`} name="mensagem" rows="4"></textarea>
  </div>

  {/* Bot trap. Hidden from people and from assistive technology alike. */}
  <div class="absolute left-[-9999px]" aria-hidden="true">
    <label for={`${id}-site`}>Não preencha este campo</label>
    <input id={`${id}-site`} name="site" type="text" tabindex="-1" autocomplete="off" />
  </div>

  {/* Turnstile mounts here. The height is reserved because the widget arrives
      in an iframe after first paint, and the submit row must not jump. */}
  <div class="flex flex-col gap-2">
    <div class="turnstile-slot" data-turnstile data-sitekey={turnstileSiteKey}></div>
    <p
      class="hidden text-small font-semibold text-plop-pink"
      id={`${id}-turnstile-erro`}
      aria-live="polite"
      data-error-for="turnstile"
    >
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-4 pt-1">
    <Button type="submit" variant="primary" size="lg" icon="send" data-submit>
      <span>Enviar</span>
    </Button>
    <p class="text-small text-white" data-form-status role="status" aria-live="polite">
      Resposta em até um dia útil.
    </p>
  </div>
</form>

<style>
  /* Turnstile's own iframe is 65px tall in every responsive size it picks. */
  .turnstile-slot {
    min-block-size: 65px;
  }
</style>

<script>
  type FieldName = "nome" | "negocio" | "email" | "whatsapp";

  const RULES: Record<FieldName, { test: (v: string) => boolean; message: string }> = {
    nome: {
      test: (v) => v.trim().length >= 2,
      message: "Escreva seu nome para sabermos com quem falamos.",
    },
    negocio: {
      test: (v) => v.trim().length >= 2,
      message: "Diga qual é o seu negócio.",
    },
    email: {
      test: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim()),
      message: "Confira o e-mail: falta algo no endereço.",
    },
    whatsapp: {
      test: (v) => v.replace(/\D/g, "").length >= 10,
      message: "Informe o WhatsApp com DDD.",
    },
  };

  const FAILURES: Record<string, string> = {
    invalid_fields: "Confira os campos marcados acima.",
    rate_limited: "Muitas mensagens deste dispositivo. Tente de novo em alguns minutos.",
    verification_failed:
      "A verificação de segurança não passou. Recarregue a página e tente de novo.",
    default: "Não conseguimos enviar agora. Tente de novo ou chame no WhatsApp.",
  };

  /** Must match the action the Worker compares against on every submission. */
  const TURNSTILE_ACTION = "contact";

  type TurnstileApi = {
    render: (container: HTMLElement, options: Record<string, unknown>) => string;
    reset: (widgetId: string) => void;
    getResponse: (widgetId: string) => string | undefined;
  };

  const turnstileWindow = window as Window & { turnstile?: TurnstileApi };

  /**
   * One script tag per page, however many forms are mounted. Explicit render is
   * what lets each widget be reset on its own after a submission that keeps the
   * visitor on the page.
   */
  let apiLoading: Promise<void> | null = null;
  const loadTurnstileApi = (): Promise<void> => {
    if (turnstileWindow.turnstile) return Promise.resolve();
    if (apiLoading) return apiLoading;

    apiLoading = new Promise<void>((resolve, reject) => {
      const script = document.createElement("script");
      script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
      script.async = true;
      script.addEventListener("load", () => resolve(), { once: true });
      script.addEventListener(
        "error",
        () => reject(new Error("turnstile api failed to load")),
        { once: true },
      );
      document.head.appendChild(script);
    });

    return apiLoading;
  };

  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const slot = form.querySelector<HTMLElement>("[data-turnstile]");
    const turnstileError = form.querySelector<HTMLElement>('[data-error-for="turnstile"]');
    let widgetId: string | undefined;

    const showTurnstileError = (message: string) => {
      if (!turnstileError) return;
      turnstileError.textContent = message;
      turnstileError.classList.toggle("hidden", message === "");
    };

    /**
     * The form sits in the footer of every page, so the widget is mounted only
     * once it is about to be seen or touched — the challenge costs a request
     * and a third-party script, and most visits never reach the form.
     */
    const mountTurnstile = async () => {
      if (widgetId !== undefined || !slot?.dataset.sitekey) return;
      /* Claim the slot before awaiting, so a scroll and a focus racing each
         other cannot both render a widget into it. */
      widgetId = "";

      try {
        await loadTurnstileApi();
        widgetId = turnstileWindow.turnstile?.render(slot, {
          sitekey: slot.dataset.sitekey,
          action: TURNSTILE_ACTION,
          theme: "light",
          size: "flexible",
          language: "pt-BR",
        });
      } catch {
        widgetId = undefined;
        showTurnstileError("Não foi possível carregar a verificação. Recarregue a página.");
      }
    };

    if (slot) {
      form.addEventListener("focusin", mountTurnstile, { once: true });

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          void mountTurnstile();
        },
        /* Mount a little before the form lands, so the challenge is already
           solved by the time the fields are filled. */
        { rootMargin: "300px" },
      );
      observer.observe(form);
    }

    const showError = (name: FieldName, message: string) => {
      const slot = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      if (!slot || !input) return;
      slot.textContent = message;
      slot.classList.toggle("hidden", message === "");
      input.setAttribute("aria-invalid", message ? "true" : "false");
      input.classList.toggle("border-plop-pink", Boolean(message));
    };

    (Object.keys(RULES) as FieldName[]).forEach((name) => {
      const input = form.elements.namedItem(name) as HTMLInputElement | null;
      input?.addEventListener("blur", () => {
        if (input.value.trim() === "") return;
        showError(name, RULES[name].test(input.value) ? "" : RULES[name].message);
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      let firstInvalid: HTMLInputElement | null = null;
      (Object.keys(RULES) as FieldName[]).forEach((name) => {
        const input = form.elements.namedItem(name) as HTMLInputElement | null;
        if (!input) return;
        const ok = RULES[name].test(input.value);
        showError(name, ok ? "" : RULES[name].message);
        if (!ok && !firstInvalid) firstInvalid = input;
      });

      if (firstInvalid) {
        (firstInvalid as HTMLInputElement).focus();
        if (status) status.textContent = "Confira os campos marcados acima.";
        return;
      }

      /* Fields are checked first on purpose: the token is single-use, and a
         submission that stops on a typo should not burn it. */
      if (slot) {
        /* A visitor who submits the instant the form appears can arrive before
           the widget does; mounting is idempotent, so this only ever helps. */
        await mountTurnstile();

        const token = widgetId ? turnstileWindow.turnstile?.getResponse(widgetId) : "";
        if (!token) {
          showTurnstileError("Aguarde a verificação de segurança terminar e envie de novo.");
          if (status) status.textContent = "Verificação de segurança pendente.";
          return;
        }
        showTurnstileError("");
      }

      submit?.setAttribute("disabled", "true");
      submit?.classList.add("opacity-60", "pointer-events-none");
      if (status) status.textContent = "Enviando…";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });

        if (!response.ok) {
          // The server validates again and its answer wins: it is the one that
          // knows whether the message actually left.
          const payload = (await response.json().catch(() => null)) as {
            error?: string;
            fields?: string[];
          } | null;

          (payload?.fields ?? []).forEach((name) => {
            if (name in RULES) showError(name as FieldName, RULES[name as FieldName].message);
          });

          if (status) status.textContent = FAILURES[payload?.error ?? ""] ?? FAILURES.default;
          return;
        }

        form.reset();
        if (status) {
          status.textContent = "Recebido. Respondemos em até um dia útil.";
        }
        // Conversion counts only once the server has confirmed it.
        window.dispatchEvent(new CustomEvent("plop:contact_submit"));
      } catch {
        if (status) status.textContent = FAILURES.default;
      } finally {
        submit?.removeAttribute("disabled");
        submit?.classList.remove("opacity-60", "pointer-events-none");
        /* The token was redeemed at siteverify — or thrown away with a failed
           request. Either way this one is spent, so a retry needs a fresh one. */
        if (widgetId) turnstileWindow.turnstile?.reset(widgetId);
      }
    });
  });
</script>
