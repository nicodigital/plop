---
/**
 * Authored icon set. One family, 24px grid, 2px stroke, round caps and
 * joins, so nothing on the page mixes stroke weights or icon idioms.
 * WhatsApp is drawn as a UI glyph in that same family rather than as the
 * official solid mark, so the dock and the contact page match everything else.
 */
export type IconName =
  | "arrow-right"
  | "arrow-down"
  | "send"
  | "check"
  | "plus"
  | "menu"
  | "close"
  | "whatsapp"
  | "chevron-left"
  | "chevron-right"
  | "play"
  | "pause"
  | "desktop"
  | "desktop-speed"
  | "calendar"
  | "phone"
  | "email";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = "" } = Astro.props;

const strokePaths: Partial<Record<IconName, string>> = {
  "arrow-right": "M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5",
  "arrow-down": "M12 4v15m0 0 5.5-5.5M12 19l-5.5-5.5",
  send: "M4.7 4.03 21 12 4.7 19.97a.5.5 0 0 1-.55-.13.56.56 0 0 1-.12-.57L6.5 12 4.03 4.73a.56.56 0 0 1 .12-.57.5.5 0 0 1 .55-.13M6.5 12H21",
  check: "M4.5 12.5 9.5 17.5 19.5 6.5",
  plus: "M12 5v14M5 12h14",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6L6 18",
  "chevron-left": "M15 5l-7 7 7 7",
  "chevron-right": "M9 5l7 7-7 7",
  play: "M8 5.6v12.8L18.4 12 8 5.6Z",
  pause: "M9.5 5.5v13M14.5 5.5v13",
  desktop: "M12 16H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v8m-6 6 2 2 4-4M7 20h4m-2-4v4",
  "desktop-speed":
    "M14.5 16H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v7.5M7 20h6m-4-4v4m10-4-2 3h4l-2 3",
  calendar:
    "M11.5 21H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6M16 3v4M8 3v4m-4 4h16m-5 8 2 2 4-4",
  whatsapp:
    "m3 21 1.65-3.8a9 9 0 1 1 3.4 2.9zM9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0za5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1",
  phone: "M6 5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2zm5-1h2m-1 13v.01",
  email: "M8 12a4 4 0 1 0 8 0 4 4 0 1 0-8 0M16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-5.5 8.28",
};

const path = strokePaths[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={path} />
</svg>
