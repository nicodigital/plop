---
/**
 * Share row for a single piece of content. Plain links to each network's
 * public share endpoint — no SDK, no widget, no client JavaScript: every
 * href is final at build time, so the bar works before (and without) any
 * script on the page.
 */
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";

interface Props {
  /** Absolute URL of the page being shared. Relative URLs break every target. */
  url: string;
  title: string;
  label?: string;
  /** `light` is the same bar on a blue ground: light label, light icons. */
  variant?: "default" | "light";
  class?: string;
}

const {
  url,
  title,
  label = "Compartilhar",
  variant = "default",
  class: className = "",
} = Astro.props;

type ShareTarget = {
  /** Also the analytics value, so a report reads by network. */
  id: string;
  name: string;
  icon: IconName;
  href: string;
};

const page = encodeURIComponent(url);
const text = encodeURIComponent(title);

const targets: ShareTarget[] = [
  {
    id: "facebook",
    name: "Facebook",
    icon: "facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${page}`,
  },
  {
    id: "twitter",
    name: "X",
    icon: "x-twitter",
    /* x.com/intent/post is the current endpoint; twitter.com/intent/tweet
       still redirects to it, but redirects cost the visitor a round trip. */
    href: `https://x.com/intent/post?url=${page}&text=${text}`,
  },
  {
    id: "linkedin",
    name: "LinkedIn",
    icon: "linkedin",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${page}`,
  },
  {
    id: "whatsapp",
    name: "WhatsApp",
    icon: "whatsapp",
    /* wa.me with no number is the share sheet: it opens the installed app on
       a phone and WhatsApp Web on a desktop, which is the split we want and
       the reason this is not an api.whatsapp.com/send link. */
    href: `https://wa.me/?text=${encodeURIComponent(`${title} ${url}`)}`,
  },
];

/* Same bar, two grounds: white/paper inside an article, brand blue on the
   project pages. Only the label tint, the icon surface and the drop change. */
const isLight = variant === "light";

const labelClass = isLight ? "text-white" : "text-blue-700";

const linkClass = isLight
  ? "btn--share-light border-white/70 text-white hover:border-white hover:bg-white hover:text-plop-ink"
  : "btn--share border-plop-hairline text-plop-ink hover:border-plop-ink hover:bg-plop-ink hover:text-white";
---

<div
  class={`flex flex-col flex-wrap justify-between gap-x-6 gap-y-4 pt-7 ${className}`}
>
  <p class={labelClass}>{label}</p>

  <ul class="flex flex-wrap items-center gap-2.5">
    {
      targets.map((target) => (
        <li>
          <a
            href={target.href}
            class={`btn inline-flex size-11 items-center justify-center rounded-full border-2 no-underline ${linkClass}`}
            target="_blank"
            rel="noopener noreferrer"
            data-track="post_share"
            data-track-value={target.id}
          >
            <Icon name={target.icon} size={20} />
            <span class="sr-only">Compartilhar no {target.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
