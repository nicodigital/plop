---
import Icon from "./Icon.astro";
import type { IconName } from "./Icon.astro";

interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "outline" | "solid-ink";
  size?: "md" | "lg";
  icon?: IconName;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  icon = "arrow-right",
  class: className = "",
  ...rest
} = Astro.props;

// The hover lift, its shadow colour and the press live in `.btn`
// (src/styles/global.css); the variants only name the surface.
const base =
  "btn group inline-flex items-center justify-center gap-2.5 rounded-full font-display font-bold tracking-[-0.01em] no-underline";

const sizes = {
  md: "min-h-[3rem] px-[4rem] text-base",
  lg: "min-h-[3.4rem] px-[2rem] text-article",
};

const variants = {
  primary: "btn-lime bg-plop-lime text-plop-ink hover:bg-plop-lime-bright",
  outline:
    "btn--outline border-2 border-white text-white hover:border-white hover:bg-white/10",
  "solid-ink": "btn--solid-ink bg-plop-ink text-white hover:bg-plop-blue-800",
};

const classes = [base, sizes[size], variants[variant], className].join(" ");
const Tag = href ? "a" : "button";
---

<Tag class={classes} {...href ? { href } : { type }} {...rest}>
  <slot />
  <Icon
    name={icon}
    size={20}
    class="shrink-0 transition-transform duration-[var(--duration-fast)] ease-[var(--ease-plop-out)] group-hover:translate-x-1"
  />
</Tag>
