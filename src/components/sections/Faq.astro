---
import Icon from "../ui/Icon.astro";
import { FAQ } from "../../data/faq.ts";

interface Props {
  headingLevel?: "h1" | "h2";
}

const { headingLevel: Heading = "h2" } = Astro.props;
---

<section
  id="duvidas"
  class="on-white py-[clamp(64px,8vw,96px)]"
  aria-labelledby="duvidas-titulo"
>
  <div class="shell">

      <div class="mx-auto mb-[clamp(40px,6vw,80px)] max-w-[40rem]">
        <Heading
          id="duvidas-titulo"
          class="mb-6 text-center text-[length:var(--text-h2)] lg:mb-10 anim"
          data-anim="bottom"
          data-delay="200"
        >
          Suas dúvidas, nossas respostas
        </Heading>
        <p class="mx-auto mt-6 text-center text-[length:var(--text-lead)] leading-[1.3] text-plop-blue-deep lg:max-w-[35ch] anim" data-anim="bottom" data-delay="400">
          As perguntas que surgem com frequência, respondidas aqui para facilitar sua jornada.
        </p>
      </div>

      {/*
        The list is narrowed to two thirds so a question never runs the full
        1440px. That fraction is of the shell, though, and on a phone the
        shell is already the question's measure — two thirds of it boxes every
        question into three ragged lines beside an empty column. The cap is a
        width in ch from the breakpoint up, not a share of the screen.
      */}
      <div class="mx-auto w-full max-w-[64ch]">
        {
          FAQ.map((item) => (
            <details class="group border-t border-plop-hairline last:border-b" name="faq">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 sm:gap-6 sm:py-6 [&::-webkit-details-marker]:hidden">
                <h3 class="font-display text-ui-lg font-semibold text-plop-ink">
                  {item.question}
                </h3>
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full border-2 border-plop-hairline text-plop-blue transition-[transform,border-color,background-color] duration-[var(--duration-normal)] ease-[var(--ease-plop-out)] group-open:rotate-45 group-open:border-plop-blue group-open:bg-plop-blue group-open:text-white">
                  <Icon name="plus" size={20} />
                </span>
              </summary>
              <p class="muted measure pb-7 sm:pr-4">{item.answer}</p>
            </details>
          ))
        }
      </div>

  </div>
</section>
