---
import { PROJECTS } from "../../data/projects.ts";

interface Props {
  /** The home uses the short intro; /projetos/ supplies its own heading. */
  heading?: string;
  intro?: string;
  headingLevel?: "h2" | "h1";
}

const {
  heading = "Sites otimizados para <span class='text-plop-lime'>inteligencia artifical.</span>",
  intro = "Projetos reais, entregues e no ar. Mostramos por setor:<br> os nomes dos clientes ficam com eles.",
  headingLevel: Heading = "h2",
} = Astro.props;

/**
 * Two bands, five projects each. One band reads as a queue; two bands
 * travelling at different speeds read as a body of work — there is always
 * something entering and something leaving, and the eye never settles into
 * the rhythm of a single strip.
 */
const ROWS = [PROJECTS.slice(0, 5), PROJECTS.slice(5)];

/** The lower band covers more ground in the same time, so it runs faster. */
const ROW_SPEED = [9000, 6800];
---

{/*
  The rail at its widest. For the whole page the argument obeys a column;
  here it takes the full viewport once, and that break is what keeps the
  spine from reading as a two-column template.
*/}
<section
  id="projetos"
  class="on-blue relative flex flex-col justify-center py-[var(--section-space)] lg:min-h-svh lg:py-[clamp(72px,8vh,120px)]"
  aria-labelledby="projetos-titulo"
>
  <div class="shell">
    <div class="max-w-[44rem] mx-auto pb-10 lg:pb-15">
      <Heading
        id="projetos-titulo"
        class="text-[length:var(--text-h2)] text-center anim"
        data-anim="bottom"
        data-delay="200"
      >
        <Fragment set:html={heading} />
      </Heading>
      <p class="muted balanced-breaks mt-10 text-center text-[length:var(--text-lead)] anim" data-anim="bottom" data-delay="400">
        <Fragment set:html={intro} />
      </p>
    </div>
  </div>

  {/*
    Full-bleed breakout: the bands escape whatever column contains them and
    span the viewport, so the tiles are cut by the screen and not by a
    container edge.
  */}
  <div
    class="relative left-1/2 mt-[clamp(32px,4vw,56px)] flex w-screen -translate-x-1/2 flex-col gap-8 overflow-hidden"
  >
    {
      ROWS.map((row, rowIndex) => (
        <div
          class="swiper w-full"
          role="group"
          aria-label={`Projetos entregues, faixa ${rowIndex + 1} de ${ROWS.length}`}
          data-projects-swiper
          data-row={rowIndex}
          data-speed={ROW_SPEED[rowIndex]}
        >
          {/* `list-style: none` strips list semantics in Safari, so the role is
              restored by hand — the band is a list of projects, and the count
              is what tells a screen-reader user how much work is here. */}
          <ul class="swiper-wrapper !list-none" role="list">
            {row.map((project) => {
              /* A tile with a live site is a link; one without is just a tile.
                 An <a> with no href is neither focusable nor announced, so it
                 must not be rendered at all. */
              const Tile = project.url ? "a" : "div";
              const linkProps = project.url
                ? { href: project.url, target: "_blank", rel: "noopener noreferrer" }
                : {};

              return (
                <li class="swiper-slide !h-auto">
                  <article class="h-full">
                    <Tile class="tile flex h-full flex-col" {...linkProps}>
                      {/* The capture is decoration: the sector and the description below
                         carry everything the tile claims. */}
                      <figure class="card-swiper" aria-hidden="true">
                        <video
                          class="size-full object-cover"
                          muted
                          loop
                          playsinline
                          preload="none"
                          poster={`/assets/portfolio/project-${project.slug}-poster.webp`}
                          width="720"
                          height="356"
                          aria-hidden="true"
                          tabindex="-1"
                          data-project-video
                        >
                          <source
                            src={`/assets/portfolio/project-${project.slug}.webm`}
                            type="video/webm"
                          />
                          <source
                            src={`/assets/portfolio/project-${project.slug}.mp4`}
                            type="video/mp4"
                          />
                        </video>
                      </figure>

                      <div class="flex flex-1 flex-col gap-1.5 px-1 pt-5">
                        <h3 class="font-display text-ui-xl font-semibold text-white">
                          {project.sector}
                          {project.url && (
                            <span class="sr-only"> — abrir o site em uma nova aba</span>
                          )}
                        </h3>
                        <p class="muted max-w-[46ch] text-ui">{project.description}</p>
                      </div>
                    </Tile>
                  </article>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Tile width is set here rather than through slidesPerView, because a
     marquee needs a fixed tile the viewport can cut at any width — not a
     fraction of the screen that reflows as the screen changes. */
  [data-projects-swiper] .swiper-slide {
    /* On a phone the tile has to leave room for its neighbours to show at the
       edges — that cut is the point of the band — without being so wide that
       a whole tile, and the sector name under it, is rarely on screen at
       once. Above 82vw the metadata is clipped at both edges most of the
       time, and the sector is the only name these projects carry. */
    width: min(76vw, 340px);
  }

  @media (min-width: 768px) {
    [data-projects-swiper] .swiper-slide {
      width: 44vw;
    }
  }

  @media (min-width: 1280px) {
    [data-projects-swiper] .swiper-slide {
      width: min(40vw, 800px);
    }
  }

  /* Constant speed. Swiper's default ease would make a continuous band
     breathe in and out, which reads as a stutter rather than as travel. */
  [data-projects-swiper] .swiper-wrapper {
    transition-timing-function: linear;
  }

  /* The bands are not dragged any more — the tile is the target, and a link
     tile says so. Without this the whole band reads as grabbable and the
     click never looks available. */
  a.tile {
    cursor: pointer;
  }

  a.tile:focus-visible {
    outline: 2px solid var(--color-plop-lime);
    outline-offset: 6px;
    border-radius: var(--radius-plop-lg);
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";
  import "swiper/css";

  const hosts = Array.from(document.querySelectorAll<HTMLElement>("[data-projects-swiper]"));

  if (hosts.length) {
    /** At most this many tiles decode at once, however many are on screen. */
    const MAX_DECODING = 4;

    /**
     * How many tiles per band are fetched ahead of the section arriving. Two
     * is roughly what a band shows at once; anything past that is
     * speculative bytes for tiles the visitor may never reach.
     */
    const WARM_PER_BAND = 2;

    const bands = hosts.map((host, index) => {
      const swiper = new Swiper(host, {
        modules: [Autoplay],
        slidesPerView: "auto",
        spaceBetween: 16,
        loop: true,
        // Delay zero plus a long duration is what turns Swiper's paging into
        // a continuous crawl: always mid-transition, never resting. The two
        // bands differ here, which is the whole point of there being two.
        speed: Number(host.dataset.speed ?? 8000),
        autoplay: { delay: 0, disableOnInteraction: false, pauseOnMouseEnter: false },
        // The tile is a link, and a link has to survive a pointer press.
        // Swiper's touch layer treats any press on a band that is mid-travel
        // as the start of a drag and then cancels the click that follows, so
        // the whole of it is turned off: these bands are a marquee, not a
        // carousel, and there is nothing here for the visitor to drag.
        allowTouchMove: false,
        simulateTouch: false,
        preventClicks: false,
        preventClicksPropagation: false,
        grabCursor: false,
        // The lower band starts further along so the two never line up into
        // a grid, which would undo the point of separate speeds.
        initialSlide: index * 2,
        breakpoints: { 768: { spaceBetween: 32 } },
      });

      /**
       * The bands never stop while they are on screen. Freezing exists only
       * for the off-screen case: stopping autoplay alone leaves the current
       * transition running, so the wrapper has to be pinned where it is.
       */
      const freeze = () => {
        const current = new DOMMatrix(getComputedStyle(swiper.wrapperEl).transform).m41;
        swiper.autoplay.stop();
        swiper.setTransition(0);
        swiper.setTranslate(current);
      };

      const start = () => {
        // Freezing interrupts the transition without it ever firing
        // transitionend, so Swiper still believes it is mid-animation and
        // silently refuses every further step. Clearing that is what makes
        // resume work; without it the band stays pinned for good.
        swiper.animating = false;
        swiper.autoplay.stop();
        swiper.autoplay.start();
        // Delay zero schedules the next step off the end of the current
        // transition. A frozen wrapper has none, so the first step is manual.
        swiper.slideNext(swiper.params.speed as number);
      };

      return { host, swiper, freeze, start };
    });

    /**
     * Two bands means twice as many tiles on screen, and a tile is a video.
     * Playback therefore follows the screen and then a budget: the tiles
     * nearest the middle of the viewport decode, the rest hold their poster.
     * At the edges they are cut off anyway, so the ceiling costs nothing to
     * look at and saves a phone several megabytes.
     */
    const bandVideos = hosts.map((host) =>
      Array.from(host.querySelectorAll<HTMLVideoElement>("[data-project-video]")),
    );
    const videos = bandVideos.flat();
    const onScreen = new Set<HTMLVideoElement>();

    /**
     * Orders tiles by how close they sit to the middle of the screen, which
     * is the one measure that survives the travel: a band is always moving,
     * so DOM order says nothing about what the visitor is looking at.
     */
    const nearestToCentre = (list: readonly HTMLVideoElement[], count: number) => {
      const centre = window.innerWidth / 2;
      return list
        .map((video) => {
          const box = video.getBoundingClientRect();
          return { video, distance: Math.abs(box.left + box.width / 2 - centre) };
        })
        .sort((a, b) => a.distance - b.distance)
        .slice(0, count)
        .map((entry) => entry.video);
    };

    /** Tiles already told to fetch, so nothing is asked to load twice. */
    const warmed = new WeakSet<HTMLVideoElement>();

    /**
     * Takes a tile off `preload="none"` and starts the fetch. The markup
     * ships with no preload at all so the hero owns the first connection;
     * from here every byte is asked for deliberately. `load()` rather than
     * the attribute alone, because a video that has already declined to
     * fetch does not re-run source selection when the attribute changes.
     */
    const warm = (video: HTMLVideoElement) => {
      if (warmed.has(video)) return;
      warmed.add(video);
      video.preload = "auto";
      video.load();
    };

    const sync = () => {
      const budget = nearestToCentre([...onScreen], MAX_DECODING);
      const allowed = new Set(document.hidden ? [] : budget);

      videos.forEach((video) => {
        if (allowed.has(video)) {
          warm(video);
          void video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    };

    // Nothing decodes until a tile is genuinely on screen. Loading both
    // bands up front would cost a phone several megabytes for work it may
    // never scroll to, which is the opposite of what this site sells.
    const tileObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) onScreen.add(video);
          else onScreen.delete(video);
        });
        sync();
      },
      { threshold: 0.25 },
    );
    videos.forEach((video) => tileObserver.observe(video));

    /**
     * The bands are the section directly under the hero, so any scroll at all
     * is already a request for them. Waiting for a tile to cross the edge of
     * the screen means the band arrives holding its poster while the fetch
     * starts; warming the leading tiles on the first sign of scroll buys that
     * back, and costs nothing to a visitor who never leaves the hero.
     * Everything past those tiles still waits for the observer.
     *
     * Intent rather than position: wheel and touch fire before the page has
     * moved a pixel, and Lenis eases the window's own scroll, so the native
     * scroll event still arrives for every other input.
     */
    const connection = (
      navigator as Navigator & {
        connection?: { saveData?: boolean; effectiveType?: string };
      }
    ).connection;
    const metered =
      connection?.saveData === true || /(^|-)2g$/.test(connection?.effectiveType ?? "");

    if (!metered) {
      const warmLeadingTiles = () => {
        bandVideos.forEach((list) => nearestToCentre(list, WARM_PER_BAND).forEach(warm));
      };

      const intents = ["scroll", "wheel", "touchstart", "keydown"] as const;
      const onFirstIntent = () => {
        intents.forEach((intent) => window.removeEventListener(intent, onFirstIntent));
        // Off the input's own frame: a fetch must not compete with the scroll
        // that asked for it.
        if (typeof window.requestIdleCallback === "function") {
          window.requestIdleCallback(warmLeadingTiles, { timeout: 500 });
        } else {
          window.setTimeout(warmLeadingTiles, 200);
        }
      };
      intents.forEach((intent) =>
        window.addEventListener(intent, onFirstIntent, { passive: true }),
      );
    }

    // The budget is decided by horizontal position, which the travel keeps
    // changing, so it has to be re-decided as the bands move rather than
    // only when a tile crosses the edge of the screen.
    let rebudget: number | undefined;
    const scheduleRebudget = () => {
      window.clearInterval(rebudget);
      rebudget = window.setInterval(sync, 1200);
    };

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) videos.forEach((video) => video.pause());
      else sync();
    });

    // The only thing that ever holds a band is being off screen, where
    // nobody can see it and a compositor thread would be burnt for nothing.
    // While the section is in view the travel runs without end.
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const band = bands.find((candidate) => candidate.host === entry.target);
          if (!band) return;
          if (entry.isIntersecting) {
            band.start();
            scheduleRebudget();
          } else {
            band.freeze();
            window.clearInterval(rebudget);
          }
        });
      },
      { threshold: 0 },
    );
    bands.forEach((band) => sectionObserver.observe(band.host));

    window.dispatchEvent(new CustomEvent("plop:project_view"));
  }
</script>
