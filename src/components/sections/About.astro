---
import Icon, { type IconName } from "../ui/Icon.astro";

/**
 * What the monthly plan delivers, grouped into three claims instead of one
 * flat list of seven: the site, what keeps it fast and online, and what keeps
 * it growing. Seven single-line bullets read as a spec sheet; three grouped
 * cards read as an argument.
 *
 * This replaces the Core Web Vitals table that used to sit here. LCP, CLS and
 * INP are build targets an engineer reads, and the buyer on this page is a
 * shop owner on a phone. Performance survives as an outcome, not a metric.
 */
const groups: { title: string; icon: IconName; items: string[] }[] = [
  {
    title: "Site One Page + Blog",
    icon: "desktop",
    items: ["Site profissional One Page", "Blog integrado", "Design responsivo"],
  },
  {
    title: "Rápido e no ar",
    icon: "desktop-speed",
    items: ["Alta performance", "Hospedagem"],
  },
  {
    title: "Serviço mensal",
    icon: "calendar",
    items: ["Suporte técnico quando precisar", "Manutenção e atualizações", "1 publicação mensal no blog"],
  },
];
---

<section id="servico" class="on-ink relative py-[var(--section-space)]">
  <div class="shell">
    <div class="mx-auto max-w-[56rem] text-center">
      <h2
        class="mx-auto max-w-[20ch] text-[length:var(--text-h2)]"
        data-reveal
      >
        Seu site não precisa parar <span class="text-plop-lime">depois de publicado.</span>
      </h2>
      {/*
        The line breaks are a desktop composition, not punctuation: on a phone
        they land mid-sentence and the centred paragraph goes ragged. They are
        drawn by CSS from `lg` up instead, so the copy is one flowing block
        wherever the measure is narrow.
      */}
      <p
        class="muted balanced-breaks mx-auto mt-8 max-w-[55ch] text-[length:var(--text-lead)] leading-[1.3]"
        data-reveal
      >
        Criamos seu site e continuamos cuidando dele todos os meses.<br /> O plano
        mensal inclui hospedagem, suporte técnico e a publicação<br /> de <strong
          class="font-semibold text-white"
          data-numeric>1 novo post mensal</strong
        >, para que seu site siga ativo, atualizado e ganhando relevância em
        buscadores e inteligência artificial ao longo do tempo.
      </p>
    </div>

    <h3
      class="mt-[clamp(56px,7vw,96px)] text-center text-[length:var(--text-h4)] text-white"
      data-reveal
    >
      Você recebe
    </h3>

    <ul class="mt-[clamp(32px,3.5vw,48px)] grid gap-[clamp(16px,2vw,60px)] md:grid-cols-3">
      {
        /* The tall minimum on the card exists to level three of them standing
           side by side. Stacked on a phone there is nothing to level, and it
           turns the shortest card into a long empty panel — so it starts
           where the columns do. */
        groups.map((group, index) => (
          <li
            class="flex flex-col justify-between rounded-[var(--radius-plop-lg)] border border-blue-400 bg-plop-ink/30 p-[clamp(28px,3vw,50px)] backdrop-blur-xs md:min-h-[26rem]"
            style={`corner-shape: squircle; --reveal-delay: ${index * 90}ms;`}
            data-reveal
          >
            <h4 class="flex flex-col gap-5 font-display text-h4 font-semibold text-plop-lime">
              <Icon name={group.icon} size={50} class="shrink-0" />
              {group.title}
            </h4>
            <ul class="mt-8 flex flex-col gap-3 md:mt-12">
              {group.items.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon
                    name="check"
                    size={20}
                    class="mt-1 shrink-0 text-plop-lime"
                  />
                  <span
                    class="text-article text-white"
                    data-numeric={/[0-9]/.test(item) ? true : undefined}
                  >
                    {item}
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
