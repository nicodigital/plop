---
/**
 * The Core Web Vitals row states build targets, not measured client results.
 * The copy says so explicitly: these are the thresholds every site is built
 * against, never a claim about numbers already achieved for a client.
 */
const targets = [
  { metric: "LCP", limit: "2,5s", meaning: "até a primeira tela aparecer" },
  { metric: "CLS", limit: "0,1", meaning: "de deslocamento enquanto carrega" },
  { metric: "INP", limit: "200ms", meaning: "para responder a um toque" },
];
---

<section class="on-ink relative py-[var(--section-space)]">
  <div class="shell">
    <div class="spine-grid">
      <div>
        <h2 class="text-[length:var(--text-h2)] mb-10" data-reveal>
          Mais que sites,<br />
          <span class="text-plop-lime">impulsionamos negócios.</span>
        </h2>
        <div class="muted measure mt-7 flex flex-col gap-5 text-[length:var(--text-lead)] leading-[1.3]" data-reveal>
          <p>
            Um site bonito que demora a abrir não vende. Por isso cada projeto
            do PLOP! é construído como HTML estático: sem plugin, sem painel
            pesado, sem camada que só existe para dar trabalho depois.
          </p>
          <p>
            Você não recebe um arquivo e um boa sorte. Recebe um site publicado,
            e alguém cuidando dele todo mês.
          </p>
        </div>
      </div>

      <div data-reveal>
        <h3 class="font-display text-h5 font-semibold text-white">
          As metas de performance de cada site
        </h3>

        <dl class="mt-8 flex flex-col">
          {
            targets.map((target) => (
              <div class="grid grid-cols-[auto_1fr] items-baseline gap-x-6 gap-y-1 border-t border-white/15 py-6 last:border-b">
                <dt class="font-display text-ui-lg font-semibold text-white">
                  {target.metric}
                </dt>
                <dd
                  class="justify-self-end font-display text-[clamp(2rem,3vw,2.75rem)] font-bold leading-none tracking-[-0.04em] text-white"
                  data-numeric
                >
                  ≤ {target.limit}
                </dd>
                <p class="muted col-span-2 text-ui">{target.meaning}</p>
              </div>
            ))
          }
        </dl>

        <p class="muted mt-6 text-small">
          Metas de construção medidas pelo Core Web Vitals do Google, não
          resultados de clientes.
        </p>
      </div>
    </div>
  </div>
</section>
