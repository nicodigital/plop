---
import Icon, { type IconName } from "../ui/Icon.astro";
import Button from "../ui/Button.astro";
import Modal from "../ui/Modal.astro";
import { CONTACT_ANCHOR } from "../../data/nav.ts";
/**
 * What the monthly plan delivers, grouped into three claims instead of one
 * flat list of seven: the site, what keeps it fast and online, and what keeps
 * it growing. Seven single-line bullets read as a spec sheet; three grouped
 * cards read as an argument.
 *
 * This replaces the Core Web Vitals table that used to sit here. LCP, CLS and
 * INP are build targets an engineer reads, and the buyer on this page is a
 * shop owner on a phone. Performance survives as an outcome, not a metric.
 */
const groups: { title: string; icon: IconName; items: string[] }[] = [
  {
    title: "Site One Page + Blog",
    icon: "desktop",
    items: ["Site profissional One Page", "Blog integrado", "Design responsivo"],
  },
  {
    title: "Rápido e no ar",
    icon: "desktop-speed",
    items: ["Alta performance", "Hospedagem"],
  },
  {
    title: "Serviço mensal",
    icon: "calendar",
    items: ["Suporte técnico quando precisar", "Manutenção e atualizações", "1 publicação mensal no blog"],
  },
];
---

<section
  id="servico"
  class="on-ink relative py-[var(--section-space)]"
  aria-labelledby="servico-titulo"
>
  <div class="shell">
    <div class="mx-auto max-w-[56rem] text-center">
      <h2
        id="servico-titulo"
        class="mx-auto max-w-[20ch] text-[length:var(--text-h2)]"
      >
        <span class="anim" data-anim="bottom" data-delay="200" >
          Seu site não precisa parar
        </span> 
        <span class="text-plop-lime anim" data-anim="bottom" data-delay="400" >
          depois de publicado.
        </span>
      </h2>
      {/*
        The line breaks are a desktop composition, not punctuation: on a phone
        they land mid-sentence and the centred paragraph goes ragged. They are
        drawn by CSS from `lg` up instead, so the copy is one flowing block
        wherever the measure is narrow.
      */}
      <p
        class="muted balanced-breaks mx-auto mt-8 max-w-[55ch] text-[length:var(--text-lead)] leading-[1.3] anim" data-anim="bottom" data-delay="600"
      >
        Criamos seu site e continuamos cuidando dele todos os meses.<br /> O plano
        mensal inclui hospedagem, suporte técnico e a publicação<br /> de <strong
          class="font-semibold text-white"
          data-numeric>1 novo post mensal</strong
        >, para que seu site siga ativo, atualizado e ganhando relevância em
        buscadores e inteligência artificial ao longo do tempo.
      </p>
    </div>

    <h3
      id="servico-recebe"
      class="mt-[clamp(56px,7vw,96px)] text-center text-[length:var(--text-h4)] text-white"
    >
      Você recebe
    </h3>

    <ul
      class="mt-[clamp(32px,3.5vw,48px)] grid gap-[clamp(16px,2vw,60px)] md:grid-cols-3"
      aria-labelledby="servico-recebe"
    >
      {
        /* The tall minimum on the card exists to level three of them standing
           side by side. Stacked on a phone there is nothing to level, and it
           turns the shortest card into a long empty panel — so it starts
           where the columns do. */
        groups.map((group, index) => (
          <li
            class="anim flex flex-col justify-between rounded-[var(--radius-plop-lg)] border border-blue-400 bg-plop-ink/30 p-[clamp(28px,3vw,50px)] backdrop-blur-xs md:min-h-[26rem]"
            style="corner-shape: squircle;"
            data-anim="bottom"
            data-delay={index * 200}
          >
            <h4 class="flex flex-col gap-5 font-display text-h4 font-semibold text-plop-lime">
              <Icon name={group.icon} size={50} class="shrink-0" />
              {group.title}
            </h4>
            <ul class="mt-8 flex flex-col gap-3 md:mt-12">
              {group.items.map((item) => (
                <li class="flex items-start gap-3">
                  <Icon
                    name="check"
                    size={20}
                    class="mt-1 shrink-0 text-plop-lime"
                  />
                  <span
                    class="text-article text-white"
                    data-numeric={/[0-9]/.test(item) ? true : undefined}
                  >
                    {item}
                  </span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    {/*
      The monthly post is the one item above that a shop owner reads as a
      cost rather than as a benefit, so the argument for it gets room of its
      own — in a sheet, not in a paragraph that would push the three cards
      further down the page.
    */}
    <div class="mt-20 flex justify-center">
      <Button size="lg" icon="question" data-modal-open="blog-importa">
        Por que um blog é importante
      </Button>
    </div>
  </div>

  <Modal id="blog-importa" title="Por que um blog é importante">
    <div class="prose-plop">
      <p>
        <strong>Um site parado envelhece.</strong> Quando nada muda, os buscadores
        têm pouco motivo para voltar e quem visita não encontra nada novo. Cada publicação
        é um sinal de que o negócio está ativo — e mais uma porta por onde alguém
        pode chegar até você.
      </p>
      <p>
        <strong>Cada post responde a uma pergunta real.</strong> Seus clientes pesquisam
        antes de decidir: quanto custa, quanto demora, como funciona, se vale a pena.
        Quando a resposta está no seu site, quem chega já chega mais perto de fechar
        — e conversando com você, não com o concorrente.
      </p>
      <p>
        <strong>Agora quem lê também é a inteligência artificial.</strong> ChatGPT,
        Gemini e o próprio Google montam respostas a partir do que encontram publicado.
        Para o seu negócio aparecer nelas, é preciso ter conteúdo em texto, claro e
        no seu próprio domínio. Uma página de vendas sozinha raramente dá conta disso.
      </p>
      <p>
        <strong>E a parte trabalhosa fica com a gente.</strong> O plano mensal inclui
        <strong data-numeric>1 publicação por mês</strong>: pauta, redação e publicação.
        Você não precisa escrever nada nem lembrar de atualizar o site — só seguir
        cuidando do seu negócio.
      </p>
    </div>

    <Button slot="actions" href={CONTACT_ANCHOR} variant="solid-ink" size="lg" data-track="cta_primary_click">
      Quero meu site
    </Button>
  </Modal>
</section>
