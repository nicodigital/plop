---
/**
 * The blog on the home page: the three most recent posts and one way in.
 *
 * It sits inside the light GooeyStack, so it carries no background of its
 * own — the liquid ground behind the stack is the surface.
 */
import { getCollection } from "astro:content";
import PostCard from "../ui/PostCard.astro";
import Button from "../ui/Button.astro";
import { POSTS_ON_HOME } from "../../data/blog.ts";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, POSTS_ON_HOME);
---

{
  posts.length > 0 && (
    <section
      id="blog"
      class="on-white py-[clamp(64px,8vw,96px)]"
      aria-labelledby="blog-titulo"
    >
      <div class="shell">
        <div class="mx-auto mb-10 xg:mb-17 max-w-[40rem]">
          <h2
            id="blog-titulo"
            class="anim mb-6 text-center text-[length:var(--text-h2)] lg:mb-10"
            data-anim="bottom"
            data-delay="200"
          >
            O que a gente aprende fazendo
          </h2>
          <p
            class="anim mx-auto mt-10 text-center text-[length:var(--text-lead)] text-plop-blue-deep max-w-[35ch]"
            data-anim="bottom"
            data-delay="400"
          >
            Textos curtos sobre sites, performance e presença digital. Sem
            jargão, e úteis mesmo que você não contrate a gente.
          </p>
        </div>

        <div class="grid gap-x-[clamp(20px,2.5vw,40px)] gap-y-[clamp(40px,4vw,56px)] md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post, index) => (
            <PostCard
              post={post}
              headingLevel="h3"
              sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 88vw"
              class="anim"
              data-anim="bottom"
              data-delay={index * 200}
            />
          ))}
        </div>

        <div
          class="anim mt-[clamp(40px,6vw,70px)] flex justify-center"
          data-anim="bottom"
          data-delay="200"
        >
          <Button href="/blog/" variant="solid-ink">
            Ver todos os textos
          </Button>
        </div>
      </div>
    </section>
  )
}
