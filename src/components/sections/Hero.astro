---
import Button from "../ui/Button.astro";
import Modal from "../ui/Modal.astro";
import { CONTACT_ANCHOR, PLANS_ANCHOR } from "../../data/nav.ts";
---

<section
  id="topo"
  class="hero on-blue relative isolate flex flex-col overflow-hidden focus-visible:outline-none"
  aria-labelledby="hero-titulo"
>
  <div class="hero-body shell relative flex flex-1 flex-col justify-center">
    <div class="max-w-[42rem] lg:max-w-[54%]">
      {/*
        Three headlines in one box. All three are real, crawlable HTML and they
        read in sequence: the question, the question after it, and the answer.
        The cycle is CSS alone — the markup's only job is to name the terms
        that travel and the direction they travel in.
      */}
      <h1
        id="hero-titulo"
        class="rotator max-w-[30ch] text-[length:var(--text-h1)] [word-spacing:-0.1em]"
        data-rotator
      >
    
        <span class="rotator-phrase" data-anim="bottom">
          <span class="rotator-term rotator-term--break">Seu site</span>
          <span class="rotator-term">aparece na</span>
          <span class="rotator-term text-plop-lime">IA?</span>
        </span>

        <span class="rotator-phrase" data-anim="bottom">
          <span class="rotator-term rotator-term--break">Você quer</span>
          <span class="rotator-term">aparecer,</span>
          <span class="rotator-term text-plop-lime">não é?</span>
        </span>

        <span class="rotator-phrase" data-anim="bottom">
          <span class="rotator-term rotator-term--break">Coloque seu site</span>
          <span class="rotator-term">na era</span>
          <span class="rotator-term text-plop-lime">da IA!</span>
        </span>
      </h1>

      <p
        class="muted mt-5 max-w-[40ch] text-[length:var(--text-lead)] lg:mt-7 anim" data-anim="bottom" data-delay="800"
      >
        A internet mudou. A forma de buscar também. Criamos sites rápidos, inteligentes e preparados para serem encontrados por pessoas e pela IA.
      </p>

      <div class="flex flex-wrap items-center gap-3 mt-12 lg:mt-8">
        <div class="anim" data-anim="bottom" data-delay="950" >
        <Button href={CONTACT_ANCHOR} size="lg" data-track="cta_primary_click">
          Quero meu site
        </Button>
        </div>
        <div class="anim" data-anim="bottom" data-delay="1100">
        <Button href={PLANS_ANCHOR} variant="outline" size="lg" icon="arrow-down">
          Ver planos
        </Button>
        </div>
      </div>

      {/* Separators are drawn, not listed, so a wrap never strands one. */}
      <ul
        class="hidden muted mt-6 xg:flex flex-col xg:flex-row flex-wrap gap-x-5 gap-y-1 text-ui font-semibold lg:mt-9 lg:gap-x-4 anim" data-anim="bottom" data-delay="1250"
      >
        <li class="before:mr-5 xg:before:text-plop-on-blue/55 xg:before:content-['·'] first:before:hidden lg:before:mr-6">
          No ar em semanas
        </li>
        <li class="xg:before:mr-5 xg:before:text-plop-on-blue/55 xg:before:content-['·'] first:before:hidden xg:before:mr-6">
          Hospedagem inclusa
        </li>
        <li class="xg:before:mr-5 xg:before:text-plop-on-blue/55 xg:before:content-['·'] first:before:hidden xg:before:mr-6">
          Cuidado todo mês
        </li>
      </ul>

      {/*
        The headline promises visibility in AI answers, and that is a promise
        nobody controls end to end. The qualification belongs beside the
        claim, but not inside it — so it opens the sheet instead of taking a
        line of the hero.
      */}
      <p class="anim translate-y-[8rem]" data-anim="bottom" data-delay="1400">
        <button
          type="button"
          class="hero-disclaimer text-small font-semibold underline cursor-pointer"
          data-modal-open="disclaimer-ia"
        >
          Nossa promessa
        </button>
      </p>
    </div>
  </div>

  {/*
    Decorative background. It carries no information: every word, price and
    action in this viewport is real HTML in the block above it.

    The composition follows the shape of the screen, not only its size. In
    landscape the machine sits in the right third and the copy runs beside it,
    so the video can cover the whole hero. In portrait there is no "beside" —
    a covering video puts the lit screen directly under the paragraph and the
    trust row, which is how this hero came to be unreadable on a phone. So on
    portrait the machine gets its own band at the foot of the hero, as a real
    row rather than as reserved padding, and the copy can never grow into it.
    The file carries an alpha channel, so the band needs no scrim and leaves
    no seam: what sits around the machine is the same liquid ground.
  */}
  <div class="hero-media relative -z-20 -mt-12 xg:mt-0" aria-hidden="true">
    <video
      class="hero-video"
      muted
      loop
      playsinline
      preload="none"
      poster="/assets/video/hero-laptop-alpha-poster.webp"
      data-hero-video
    >
      <source src="/assets/video/hero-laptop-alpha.webm" type="video/webm" />
      {/*
        Safari does not decode VP9 alpha, so it lands here — on the cut with
        the blue baked in. On a portrait band that would draw its own edge
        against the liquid ground, which is what the mask on `.hero-media` is
        for. The WebM path never notices the mask: what it fades is empty.
      */}
      <source src="/assets/video/hero-laptop-blue.mp4" type="video/mp4" />
    </video>
  </div>

  <Modal id="disclaimer-ia" title="Sobre a promessa de aparecer na IA">
    <div class="prose-plop">
      <p>
        <strong>O que fazemos.</strong> Todo site que sai do nosso estúdio é construído
        seguindo as práticas técnicas recomendadas por Google, Bing e pelas empresas
        de inteligência artificial: conteúdo em HTML real e legível sem JavaScript,
        estrutura semântica, dados estruturados, velocidade, sitemap, acesso liberado
        para os robôs de busca e de IA.
      </p>
      <p>
        <strong>O que ninguém pode garantir.</strong> Quem decide o que aparece em
        uma busca ou em uma resposta de IA são os buscadores e os modelos — não nós,
        e nem você. Os critérios mudam, a concorrência muda e nenhum estúdio sério
        promete <strong data-numeric>100%</strong> de efetividade. Quem promete está
        vendendo o que não controla.
      </p>
      <p>
        <strong>Por que ainda assim vale.</strong> Sem essas práticas, a chance de
        aparecer não fica menor: ela desaparece. Um site que os robôs não conseguem
        ler simplesmente não entra na disputa. Nosso trabalho é colocar o seu site
        na melhor posição possível para ser encontrado — por pessoas e pela IA.
      </p>
    </div>

    <Button slot="actions" href={CONTACT_ANCHOR} variant="solid-ink" size="lg" data-track="cta_primary_click">
      Quero meu site
    </Button>
  </Modal>
</section>

<style>
  .hero {
    min-height: max(620px, 100svh);
  }

  /* Quiet by design: it qualifies the headline, it does not compete with the
     two CTAs above it. The vertical padding is what keeps the touch target
     usable without adding a visible box around a line of text. */
  .hero-disclaimer {
    padding-block: 0.4rem;
    color: color-mix(in oklab, var(--color-plop-on-blue) 72%, transparent);
    text-decoration-color: color-mix(
      in oklab,
      var(--color-plop-on-blue) 40%,
      transparent
    );
    transition: color 0.25s ease, text-decoration-color 0.25s ease;
  }

  .hero-disclaimer:hover {
    color: var(--color-plop-lime);
    text-decoration-color: currentColor;
  }

  .hero-media {
    /* The foot of the hero the machine occupies on a portrait screen, in the
       source frame's own 16:9 — a proportion of the width, not a share of the
       height.

       That is the whole trick here. Phone heights range across two to one
       while their widths barely move, so a band measured in `svh` crops the
       frame differently on every device: one framing centres the machine on a
       tall phone and slides it off the right edge on a short one. Measured
       against the width, the crop is identical everywhere and a single
       framing holds. */
    height: 56.25vw;
    /* A safety valve for a screen so short that even this would crowd the
       copy. Nothing but a very small phone in landscape reaches it. */
    max-height: 42svh;
    flex: none;
    overflow: hidden;
    /* Only the opaque fallback has an edge to soften, and it has to stop
       short of the lid, which starts about 7% down the band. */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 5%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 5%);
  }

  .hero-video {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    width: 100%;
    /* Taller than the band, anchored at its foot: the surplus is cropped off
       the top, which is empty frame, and what is left is a machine drawn
       large enough to read on a phone rather than a thumbnail floating in its
       own margins. It is the machine's share of the width that this number
       sets — at 145% it lands on about 70% of the screen. */
    height: 145%;
    object-fit: cover;
    /* The machine sits right of centre in the frame, so the window on it is
       taken from the right edge. */
    object-position: 100% bottom;
  }

  .hero-body {
    padding-top: clamp(140px, 13vh, 168px);
    padding-bottom: clamp(16px, 3vh, 32px);
  }

  /* A short portrait screen cannot hold the copy, the actions, the trust row
     and a band at full size. The copy cannot shrink, so the band does — the
     alternative is a hero that runs past the fold and cuts the machine across
     its base, which is the one thing the band exists to avoid. */
  @media (orientation: portrait) and (max-height: 760px) {
    .hero-media {
      height: 50vw;
    }

    .hero-body {
      padding-top: clamp(76px, 11vh, 120px);
      padding-bottom: 8px;
    }
  }

  /* Landscape phones and tablets have no room for a band under the copy, so
     there the hero behaves as it does on a laptop. */
  @media (orientation: landscape) and (max-width: 1023px) {
    .hero {
      min-height: max(520px, 100svh);
    }

    /* The copy runs beside the machine here, not above it, so it has to give
       up the right of the screen the way it does on a laptop. Left at its
       portrait measure it runs under the lid and the secondary action lands
       on the bezel. */
    .hero-body > * {
      max-width: 56%;
    }
  }

  @media (orientation: landscape) and (max-width: 1023px), (min-width: 1024px) {
    .hero-media {
      position: absolute;
      inset: 0;
      height: auto;
      max-height: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .hero-video {
      position: absolute;
      inset: 0;
      height: 100%;
      object-position: 78% bottom;
    }

    .hero-body {
      padding-bottom: clamp(32px, 6vh, 64px);
    }
  }

  @media (min-width: 1024px) {
    .hero-video {
      object-position: 76% 85%;
    }

    .hero-body {
      padding-bottom: clamp(48px, 7vw, 88px);
    }
  }
</style>

<script>
  // A background video is decoration; it must never spend battery or
  // bandwidth while it is off screen or while the tab is in the background.
  // It no longer stands down for prefers-reduced-motion: that call belongs
  // to the owner of the site, and it was made.
  //
  // It also must not be what the browser measures as the largest paint. With
  // `autoplay` on the element, the first decoded frame replaced the poster as
  // the LCP candidate and the metric waited on ~830 KB of video instead of a
  // 54 KB image. So the element ships with `preload="none"` and no autoplay,
  // and every path that could start playback goes through `resume()`, which
  // stays shut until the page has finished loading. Without that single gate
  // the IntersectionObserver below would fire on registration — the hero is on
  // screen at load — and pull the video in anyway.
  const video = document.querySelector<HTMLVideoElement>("[data-hero-video]");

  if (video) {
    let unlocked = false;

    const resume = () => {
      if (!unlocked || document.hidden) return;
      void video.play().catch(() => {});
    };

    const unlock = () => {
      unlocked = true;
      video.preload = "auto";
      resume();
    };

    if (document.readyState === "complete") requestAnimationFrame(unlock);
    else window.addEventListener("load", unlock, { once: true });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) resume();
          else video.pause();
        });
      },
      { threshold: 0.05 },
    );
    observer.observe(video);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) video.pause();
      else resume();
    });
  }

  // The headline cycles forever, so the rule that governs the gooey grounds
  // applies to it too: spend frames only while it is on screen and the tab is
  // in front. The cycle itself is pure CSS — this does not time it, only
  // switches it off.
  const rotator = document.querySelector<HTMLElement>("[data-rotator]");

  if (rotator) {
    let onScreen = true;

    // The CSS rule defaults to running: if this block never executes, the
    // headline still cycles instead of freezing on a term that has already
    // faded out.
    const sync = () => {
      if (onScreen && !document.hidden) rotator.style.removeProperty("--rot-state");
      else rotator.style.setProperty("--rot-state", "paused");
    };

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        (entries) => {
          onScreen = entries[entries.length - 1].isIntersecting;
          sync();
        },
        { threshold: 0 },
      ).observe(rotator);
    }

    document.addEventListener("visibilitychange", sync);
  }
</script>
