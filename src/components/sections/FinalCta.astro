---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import { CONTACT_ANCHOR, PLANS_ANCHOR } from "../../data/nav.ts";
import laptopFront from "../../assets/img/laptop-front.png";

/**
 * The closing beat, and the one place the page stops being a full-bleed
 * surface: the blue becomes a single rounded mass sitting on the light ground
 * the stack above already established, with the laptop breaking out of its top
 * edge. That break is the whole point — the box reads as an object on the page
 * rather than as one more band, and the laptop crossing its edge is what says
 * "this is the thing you get" without a word of copy.
 *
 * The ground under it comes from the light `GooeyStack` in the page, not from
 * here: this section paints no background of its own.
 */
---

<section class="cta relative">
  <div class="cta-frame relative mx-auto">
    <div class="cta-card on-blue relative bg-plop-blue text-center anim" data-anim="bottom" data-delay="400">
      {
        /*
          The break is on the sentence, not on a measure: two whole promises,
          one per line, is the shape the line was written for. Below the card's
          width each half wraps on its own and the pairing still reads.

          The size is its own clamp rather than the H1 token: this heading sits
          inside a padded box, not across the page, so at phone width the H1
          ramp drives it to six ragged lines in a 260px column.
        */
      }
      <h2
        class="mx-auto mb-8 max-w-[25ch] text-[clamp(2.25rem,5.5vw,5rem)] lg:mb-15"
      >
        Você <span class="text-plop-lime">cuida do</span> seu negócio.<br /> A gente cuida do <span class="text-plop-lime">seu site</span>.
      </h2>
      <div
        class="mx-auto max-w-[40ch] text-center text-[length:var(--text-lead)] leading-[1.3]"
      >
        <p>
          Um investimento simples para manter sua empresa sempre online,
          atualizada e profissional.
        </p>
        <p class="mb-10 mt-6 text-center lg:mb-20 lg:mt-10">
          Comece com <span class="text-plop-lime">R$ 1.500 + R$ 300/mês.</span>
        </p>
      </div>
      <div
        class="mt-8 flex flex-wrap items-center justify-center gap-3 lg:mt-10"
      >
        <Button href={CONTACT_ANCHOR} size="lg" data-track="cta_primary_click">
          Quero meu site
        </Button>
        <Button href={PLANS_ANCHOR} variant="outline" size="lg" icon="arrow-up">
          Comparar planos
        </Button>
      </div>
    </div>

    {
      /*
        Last in the DOM so it paints over the box without a z-index, and so the
        decorative image never sits between the heading and its actions.
      */
    }
    {
      /*
        Built from the PNG master in `src/assets/` so the encoding, the widths
        and the intrinsic dimensions all come from the file itself — the box
        below reserves the laptop's room from the same aspect ratio, so the two
        can never drift apart. Alpha is load-bearing here (the render sits on
        the blue with no plate behind it), so the output stays WebP.
      */
    }
    <div class="cta-laptop">
      <div class="anim anim-img" data-anim="bottom" >
        <Image
          class="cta-laptop-img"
          src={laptopFront}
          widths={[560, 1120, laptopFront.width]}
          sizes="(min-width: 1280px) 66%, (min-width: 640px) 45vw, 400px"
          format="webp"
          quality={82}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    /* One width drives the whole composition. The laptop is an absolute
       overlay, so the room it needs is reserved by hand on both sides of the
       box's top edge: the card's top padding holds the part that dips inside,
       the section's top padding holds the part that rises out. Derived from
       the same variable, the crop can never drift apart at a breakpoint. */
    --laptop-w: clamp(232px, 45vw, 66%);
    /* The master's own 1672×941 — keep in step with the image if it is ever
       recropped, or the reserved room stops matching what is drawn. */
    --laptop-h: calc(var(--laptop-w) * 941 / 1672);
    /* Share of the laptop that sits inside the blue box. */
    --laptop-dip: 0.42;

    padding-top: calc(
      var(--laptop-h) * (1 - var(--laptop-dip)) + clamp(32px, 5vw, 72px)
    );
    padding-bottom: var(--section-space);
  }

  /* The frame the box sits in. On a phone its 40px used to stack on top of
     the card's own inset and leave the heading 260px of a 390px screen; the
     inset now shrinks with the screen instead of being a constant. */
  .cta-frame {
    padding-inline: clamp(12px, 4vw, 40px);
  }

  .cta-card {
    border-radius: var(--radius-plop-xl);
    corner-shape: squircle;
    /* The visual top of the content is the laptop's bottom edge, not the
       card's, so the dip is added back on top of the breathing space. That
       keeps the air above the heading and the air under the buttons equal,
       which is what makes the box read as balanced rather than top-loaded. */
    padding-top: calc(
      var(--laptop-h) * var(--laptop-dip) + clamp(40px, 5vw, 88px)
    );
    padding-inline: clamp(20px, 5vw, 80px);
    padding-bottom: clamp(44px, 6vw, 150px);
  }

  /* Two transforms, two elements. This box only places the laptop and never
     animates: an entrance keyframe here would overwrite the centring and the
     dip, and while it ran the transform would make this the containing block
     of anything absolute inside it. The entrance lives on the wrapper in
     between, which is in normal flow and whose transform is therefore free. */
  .cta-laptop {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--laptop-w);
    transform: translate(-50%, calc(var(--laptop-dip) * 100% - 100%));
    pointer-events: none;
  }

  /* The percentages above are read off this box own height, so the image has
     to fill the wrapper exactly or the reserved room stops matching. */
  .cta-laptop-img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
