---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import ProjectsSlider from "../components/sections/ProjectsSlider.astro";
import About from "../components/sections/About.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Studio from "../components/sections/Studio.astro";
import Plans from "../components/sections/Plans.astro";
import Faq from "../components/sections/Faq.astro";
import BlogTeaser from "../components/sections/BlogTeaser.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import GooeyStack from "../components/layout/GooeyStack.astro";
import {
  faqSchema,
  pageSchema,
  personSchema,
  plansSchema,
  projectsSchema,
} from "../data/schema.ts";
import { FEATURED_PROJECTS } from "../data/projects.ts";
import { SITE_DESCRIPTION } from "../data/site.ts";

const title = "Sites profissionais otimizados para inteligência artificial";
/* The site-wide sentence, which quotes the entry price straight from
   `plans.ts`. It used to be typed here and had drifted a plan behind. */
const description = SITE_DESCRIPTION;

/**
 * The home carries the whole offer, so it carries the whole graph: the page
 * itself, the questions, the three plans and the delivered work. The plan
 * anchors point at this page because the cards are rendered here — a rich
 * result for "Profissional" should land on the card, not on another route.
 */
const schema = [
  pageSchema({ type: "WebPage", name: title, description, path: "/" }),
  /* The organization names a `founder` on every page, but the node it points
     at was only defined on /sobre/. On the page that carries the whole offer
     that reference resolved to nothing unless a crawler went looking. */
  personSchema(),
  faqSchema(),
  plansSchema("/"),
  /* The home slider shows the featured ten, so its ItemList describes ten.
     Structured data that listed all thirty-three would describe a page the
     crawler cannot see. */
  projectsSchema(FEATURED_PROJECTS),
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  preloadImage="/assets/video/hero-laptop-alpha-poster.webp"
>
{/*
    One liquid ground for the whole blue stretch: pinned behind the three
    sections so they read as one body the page scrolls over, not as three
    restarts of the same wallpaper. It also buys one blurred filter for the
    run instead of three.
    */}
  <GooeyStack>
    <Hero />
    <ProjectsSlider />
    <Studio />
    <About />
    <!-- <HowItWorks /> -->
  </GooeyStack>
  {/*
    Same idea on the light half of the page: Plans, FAQ and the closing CTA
    share a paper/white seam, so one pale ground behind all three reads as the
    liquid surfacing again rather than as three flat panels. FinalCta carries
    its own blue as a rounded mass on top of that ground instead of as a band,
    so it no longer needs a liquid ground of its own.
    */}
  <GooeyStack tone="light" variant="b">
    <Plans />
    <Faq />
    <BlogTeaser />
    <FinalCta />
  </GooeyStack>
</BaseLayout>
