---
/**
 * The policy text itself lives in the `legal` collection, not here: the same
 * body feeds this page and its `/privacidade.md` sibling, so the two can never
 * drift apart.
 */
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageMasthead from "../components/layout/PageMasthead.astro";
import GooeyStack from "../components/layout/GooeyStack.astro";
import { breadcrumbSchema, pageSchema } from "../data/schema.ts";

const entry = await getEntry("legal", "privacidade");
if (!entry) throw new Error("Missing legal entry: privacidade");

const { Content } = await render(entry);
const { title, description } = entry.data;

const schema = [
  pageSchema({ name: title, description, path: "/privacidade/" }),
  breadcrumbSchema([{ name: title }]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <GooeyStack>
    <PageMasthead title={title} />
  </GooeyStack>

  <section
    class="relative on-white bg-white pt-10 pb-20"
    aria-label={title}
  >
    <div class="shell">
      <div class="prose-plop">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>
