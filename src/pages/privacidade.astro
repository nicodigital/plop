---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageMasthead from "../components/layout/PageMasthead.astro";
import { CONTACT_EMAIL, SITE_NAME } from "../data/site.ts";
---

<BaseLayout
  title="Política de privacidade"
  description="Quais dados o site coleta, para que servem e como pedir a exclusão."
>
  <PageMasthead title="Política de privacidade" />

  <section class="on-white bg-white py-[clamp(56px,8vw,110px)]">
    <div class="shell">
      <div class="prose-plop">
        <h2>Quais dados coletamos</h2>
        <p>
          Apenas o que você escreve no formulário de contato: nome, negócio,
          e-mail, WhatsApp, plano de interesse e mensagem. Não há cadastro, não
          há área logada e não pedimos documento nem dado de pagamento pelo site.
        </p>

        <h2>Para que usamos</h2>
        <p>
          Exclusivamente para responder ao seu contato e, se você contratar,
          conduzir o trabalho. Não vendemos, alugamos nem compartilhamos esses
          dados com terceiros para fins de marketing.
        </p>

        <h2>Por quanto tempo guardamos</h2>
        <p>
          Mensagens sem continuidade comercial são descartadas depois de 12
          meses. Dados de clientes ativos são mantidos enquanto durar a
          prestação do serviço e pelo prazo legal aplicável depois dela.
        </p>

        <h2>Cookies e medição</h2>
        <p>
          O site não usa cookies de publicidade nem rastreamento entre sites. Se
          uma ferramenta de medição de audiência for adicionada, esta página será
          atualizada antes de ela entrar no ar.
        </p>

        <h2>Seus direitos</h2>
        <p>
          Pela LGPD (Lei 13.709/2018) você pode pedir acesso, correção ou
          exclusão dos seus dados a qualquer momento. Escreva para
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> e a solicitação
          é atendida em até 15 dias.
        </p>

        <h2>Responsável</h2>
        <p>
          {SITE_NAME} — contato por <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
