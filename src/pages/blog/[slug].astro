---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import ShareBar from "../../components/ui/ShareBar.astro";
import GooeyStack from "../../components/layout/GooeyStack.astro";
import { SITE_URL } from "../../data/site.ts";
import { PLANS_ANCHOR } from "../../data/nav.ts";
import { BLOG_AUTHOR, BLOG_CATEGORIES, formatPostDate } from "../../data/blog.ts";
import {
  ORGANIZATION_ID,
  WEBSITE_ID,
  authorRef,
  breadcrumbSchema,
  pageSchema,
  personSchema,
} from "../../data/schema.ts";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const cover = post.data.cover;

/* The cover again, cropped to the social-card ratio and encoded as JPEG.
   The cover itself is a 16:9 WebP, which WhatsApp will not preview and
   LinkedIn crops unpredictably. */
const ogCard = await getImage({
  src: cover,
  width: 1200,
  height: 630,
  format: "jpg",
  fit: "cover",
});

const publishedTime = post.data.publishedAt.toISOString();
const modifiedTime = (post.data.updatedAt ?? post.data.publishedAt).toISOString();


const url = new URL(`/blog/${post.id}/`, SITE_URL).href;

/**
 * BlogPosting rather than the bare Article this route used to emit: it is the
 * type Google reads for an article rich result, and it is what the listing
 * page already calls these posts. Publisher and site are references to the
 * site-wide nodes in the layout, so there is one business in the graph.
 */
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `${url}#article`,
  headline: post.data.title,
  description: post.data.description,
  image: {
    "@type": "ImageObject",
    url: new URL(cover.src, SITE_URL).href,
    width: cover.width,
    height: cover.height,
  },
  articleSection: BLOG_CATEGORIES[post.data.category],
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: "pt-BR",
  /* Authored as minutes on the post, so the reading time in the rich result
     and the one under the title can never disagree. ISO 8601 duration. */
  timeRequired: `PT${post.data.readingMinutes}M`,
  /* A reference, not a copy: the author is one `Person` node for the whole
     site, emitted below so it resolves inside this document too. An `author`
     that restated the organization made every post look self-published by a
     brand, which is the opposite of what the byline is for. */
  author: authorRef,
  publisher: { "@id": ORGANIZATION_ID },
  isPartOf: { "@id": WEBSITE_ID },
  /* The `WebPage` node `pageSchema()` emits below, by its real id. Pointing
     at the bare URL named a node nothing defines, so the article claimed to be
     the main entity of a page that did not exist in the graph. */
  mainEntityOfPage: { "@id": `${url}#webpage` },
  url,
};

/* The only route that did not describe its own page node. `BlogPosting` says
   what the article is; `WebPage` says what the URL is, and the rest of the
   site emits both. */
const page = pageSchema({
  type: "WebPage",
  name: post.data.title,
  description: post.data.description,
  path: `/blog/${post.id}/`,
  primaryImage: cover.src,
});

const breadcrumbs = breadcrumbSchema([
  { name: "Blog", path: "/blog/" },
  { name: post.data.title },
]);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogCard.src}
  imageAlt={post.data.coverAlt}
  imageWidth={1200}
  imageHeight={630}
  ogType="article"
  article={{
    publishedTime,
    modifiedTime,
    section: BLOG_CATEGORIES[post.data.category],
  }}
  schema={[page, schema, personSchema(), breadcrumbs]}
>
  <article aria-labelledby="post-titulo">
    {/* The same liquid ground every other route opens on, instead of the flat
        blue panel this one used to paint for itself. The stack owns the wash,
        so the header stays transparent. */}
    <GooeyStack>
      <header class="on-blue">
        {/* The cover straddles the seam below, so the blue stops short and the
            image's lower half lands on the white. */}
        <div class="shell pb-[clamp(150px,17vw,240px)] pt-[clamp(132px,16vh,184px)]">
          <nav aria-label="Trilha">
            <a
              href="/blog/"
              class="muted inline-flex min-h-[44px] items-center gap-2 text-ui font-semibold no-underline transition-colors duration-[var(--duration-fast)] hover:text-white"
            >
              <Icon name="chevron-left" size={18} />
              Blog
            </a>
          </nav>

          <div class="mx-auto mt-6 max-w-[52rem] text-center">
            <p class="post-pill">{BLOG_CATEGORIES[post.data.category]}</p>

            <h1 id="post-titulo" class="mx-auto mt-6 max-w-[20ch] text-[length:var(--text-h1)]">
              {post.data.title}
            </h1>

            <p
              class="muted measure mx-auto mt-7 text-[length:var(--text-lead)]"
            >
              {post.data.description}
            </p>

            <dl class="post-meta" aria-label="Dados do texto">
              <div>
                <dt class="eyebrow">Data</dt>
                <dd data-numeric>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatPostDate(post.data.publishedAt)}
                  </time>
                </dd>
              </div>
              <div>
                <dt class="eyebrow">Autor</dt>
                <dd>{BLOG_AUTHOR}</dd>
              </div>
              <div>
                <dt class="eyebrow">Leitura</dt>
                <dd data-numeric>{post.data.readingMinutes} min</dd>
              </div>
            </dl>
          </div>
        </div>
      </header>
    </GooeyStack>

    <div class="on-white flow-root bg-white pb-[clamp(56px,8vw,110px)]">
      <div class="shell">
        {/* Pulled up by the padding the header reserved for it. The LCP of
            this route, so it loads eagerly and at high priority. */}
        <Image
          class="post-cover"
          src={cover}
          alt={post.data.coverAlt}
          widths={[640, 1400, cover.width]}
          sizes="(min-width: 1440px) 1340px, 92vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <div class="prose-plop mx-auto mt-[clamp(48px,6vw,88px)]">
          <Content />
        </div>

        {/* Below the text, above the offer: the share row is the reader's
            action once the article is read, and it must not compete with the
            CTA for the same moment. Same measure as the prose. */}
        <ShareBar
          class="mx-auto mt-[clamp(40px,5vw,64px)] max-w-[68ch]"
          url={url}
          title={post.data.title}
        />

        <aside
          class="mx-auto mt-[clamp(56px,7vw,96px)] max-w-[68ch] rounded-[var(--radius-plop-xl)] bg-plop-paper p-[clamp(28px,4vw,48px)]"
          aria-labelledby="post-cta-titulo"
        >
          <h2 id="post-cta-titulo" class="text-[length:var(--text-h3)]">
            Quer isso resolvido sem ler mais nada?
          </h2>
          <p class="muted mt-3">
            É exatamente o que a gente faz: site construído, publicado e cuidado
            todo mês, com preço fechado.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <Button href={PLANS_ANCHOR} variant="solid-ink" data-track="blog_cta_click">
              Ver planos
            </Button>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
