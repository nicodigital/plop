---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import Icon from "../../components/ui/Icon.astro";
import GooeyStack from "../../components/layout/GooeyStack.astro";
import { SITE_NAME, SITE_URL } from "../../data/site.ts";
import { BLOG_AUTHOR, BLOG_CATEGORIES, formatPostDate } from "../../data/blog.ts";

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const cover = post.data.cover;


const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  image: new URL(cover.src, SITE_URL).href,
  articleSection: BLOG_CATEGORIES[post.data.category],
  datePublished: post.data.publishedAt.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
  inLanguage: "pt-BR",
  author: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
  publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
  mainEntityOfPage: new URL(`/blog/${post.id}/`, SITE_URL).href,
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Início", item: SITE_URL },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: new URL("/blog/", SITE_URL).href,
    },
    { "@type": "ListItem", position: 3, name: post.data.title },
  ],
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={cover.src}
  schema={[schema, breadcrumbs]}
>
  <article>
    {/* The same liquid ground every other route opens on, instead of the flat
        blue panel this one used to paint for itself. The stack owns the wash,
        so the header stays transparent. */}
    <GooeyStack>
      <header class="on-blue">
        {/* The cover straddles the seam below, so the blue stops short and the
            image's lower half lands on the white. */}
        <div class="shell pb-[clamp(150px,17vw,240px)] pt-[clamp(132px,16vh,184px)]">
          <nav aria-label="Trilha">
            <a
              href="/blog/"
              class="muted inline-flex min-h-[44px] items-center gap-2 text-ui font-semibold no-underline transition-colors duration-[var(--duration-fast)] hover:text-white"
            >
              <Icon name="chevron-left" size={18} />
              Blog
            </a>
          </nav>

          <div class="mx-auto mt-6 max-w-[52rem] text-center">
            <p class="post-pill">{BLOG_CATEGORIES[post.data.category]}</p>

            <h1 class="mx-auto mt-6 max-w-[20ch] text-[length:var(--text-h1)]">
              {post.data.title}
            </h1>

            <p
              class="muted measure mx-auto mt-7 text-[length:var(--text-lead)] leading-[1.4]"
            >
              {post.data.description}
            </p>

            <dl class="post-meta">
              <div>
                <dt class="eyebrow">Data</dt>
                <dd data-numeric>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {formatPostDate(post.data.publishedAt)}
                  </time>
                </dd>
              </div>
              <div>
                <dt class="eyebrow">Autor</dt>
                <dd>{BLOG_AUTHOR}</dd>
              </div>
              <div>
                <dt class="eyebrow">Leitura</dt>
                <dd data-numeric>{post.data.readingMinutes} min</dd>
              </div>
            </dl>
          </div>
        </div>
      </header>
    </GooeyStack>

    <div class="on-white flow-root bg-white pb-[clamp(56px,8vw,110px)]">
      <div class="shell">
        {/* Pulled up by the padding the header reserved for it. The LCP of
            this route, so it loads eagerly and at high priority. */}
        <Image
          class="post-cover"
          src={cover}
          alt={post.data.coverAlt}
          widths={[640, 1400, cover.width]}
          sizes="(min-width: 1440px) 1340px, 92vw"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />

        <div class="prose-plop mx-auto mt-[clamp(48px,6vw,88px)]">
          <Content />
        </div>

        <aside
          class="mx-auto mt-[clamp(56px,7vw,96px)] max-w-[68ch] rounded-[var(--radius-plop-xl)] bg-plop-paper p-[clamp(28px,4vw,48px)]"
        >
          <h2 class="text-[length:var(--text-h3)]">
            Quer isso resolvido sem ler mais nada?
          </h2>
          <p class="muted mt-3">
            É exatamente o que a gente faz: site construído, publicado e cuidado
            todo mês, com preço fechado.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <Button href="/planos/" variant="solid-ink" data-track="blog_cta_click">
              Ver planos
            </Button>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
