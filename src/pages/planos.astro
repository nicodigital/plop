---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageMasthead from "../components/layout/PageMasthead.astro";
import Plans from "../components/sections/Plans.astro";
import Faq from "../components/sections/Faq.astro";
import FinalCta from "../components/sections/FinalCta.astro";
import GooeyStack from "../components/layout/GooeyStack.astro";
import { PLANS, formatBRL } from "../data/plans.ts";
import { SITE_URL } from "../data/site.ts";

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Planos PLOP! Sites",
  itemListElement: PLANS.map((plan, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "Service",
      name: `${plan.name} — PLOP! Sites`,
      description: plan.audience,
      url: `${SITE_URL}/planos/#${plan.slug}`,
      areaServed: "BR",
      offers: {
        "@type": "Offer",
        priceCurrency: "BRL",
        price: plan.setup,
        description: `Entrada de ${formatBRL(plan.setup)} mais ${formatBRL(plan.monthly)} por mês.`,
      },
    },
  })),
};
---

<BaseLayout
  title="Planos"
  description="Três planos com entrada e mensalidade fechadas. Hospedagem, suporte técnico e manutenção inclusos em todos."
  schema={schema}
>
  <PageMasthead
    title="Dois números, e mais nenhum."
    intro="Uma entrada para construir o site e uma mensalidade para mantê-lo no ar e cuidado. Sem taxa escondida, sem orçamento sob consulta."
  />
  <Plans heading="Escolha o tamanho do seu." intro="Todos incluem hospedagem, suporte técnico e manutenção. A diferença está no tamanho do site e no conteúdo mensal." />
  <Faq />
  {/* The closing CTA is a blue mass on a light ground, so it needs that
      ground: on the home it comes from the stack it shares with Plans and FAQ,
      here from one of its own. */}
  <GooeyStack tone="light" variant="b">
    <FinalCta />
  </GooeyStack>
</BaseLayout>
