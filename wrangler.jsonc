{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plop-sites",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The contact endpoint is not a file in ./dist, so the Worker has to see
    // that request before the asset server answers 404.
    "run_worker_first": ["/api/contato"]
  },
  "main": "./worker/index.ts",
  // Not secrets: these only shape how the message reads in the inbox. The
  // relay URL, its key, the destination mailbox and the Turnstile secret are
  // Worker secrets.
  "vars": {
    "MAIL_FROM_NAME": "PLOP! Sites",
    "MAIL_SUBJECT": "Novo contato pelo site",
    // Hostnames siteverify may report. This is the production list, so it
    // carries no localhost; .dev.vars overrides it for `wrangler dev`.
    "TURNSTILE_HOSTNAMES": "plopsites.com.br"
  },
  "observability": {
    "enabled": true
  }
}
